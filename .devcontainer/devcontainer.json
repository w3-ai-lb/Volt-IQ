// GitHub Codespaces / VS Code Dev Containers: the whole system in one click.
// On GitHub: Code > Codespaces > Create codespace on main.
// Then run the VS Code task "VoltIQ: start everything" (Terminal > Run Task).
{
  "name": "VoltIQ",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "API" },
    "5173": { "label": "Web app", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "pip install -r backend/requirements.txt pytest httpx && npm --prefix frontend ci && cd backend && python -m app.pipeline.seed",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "Dart-Code.flutter"
      ]
    }
  }
}
