# ---------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# Never commit the real .env: it is listed in .gitignore.
# ---------------------------------------------------------------

# --- Database ---------------------------------------------------
# Local development (zero setup, no install required):
DATABASE_URL=sqlite:///./energy_analytics.db
#
# Production / submission: PostgreSQL as specified in the
# Software Architecture document. Uncomment and edit:
# DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/energy_analytics

# --- Security (JWT) ---------------------------------------------
# Generate a strong key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required: with this placeholder (or any key under 32 characters) the server
# refuses to start on PostgreSQL, and on SQLite it starts with a warning.
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Password reset ---------------------------------------------
PASSWORD_RESET_EXPIRE_MINUTES=30
# false (default) = reset tokens are never returned in API responses. There is
#   no email provider yet, so customers cannot reset a forgotten password
#   themselves until email delivery is added.
# true = local demonstration only: the token comes back in the response so the
#   flow can be shown. Ignored on any database that is not SQLite, and the
#   server logs a warning if it is set there.
RETURN_RESET_TOKEN_IN_RESPONSE=false

# --- Account claiming -------------------------------------------
# Days a one-time registration code stays valid after it is issued.
REGISTRATION_CODE_VALID_DAYS=30

# --- CORS -------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Add your Vercel URL here after deploying.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Billing ----------------------------------------------------
# Price per kWh, used ONLY when a dataset has no cost column and by the
# recommendation engine when a customer has no cost history to divide.
#
# LEBANESE POUNDS, NOT DOLLARS. Every row of the provider's data says LBP:
# all 5,400 invoices, all 5,229 payments, all 18 tariffs. The figure below is
# his own most recent published rate (June 2026). The real rate changes every
# month with the diesel price and travels on the tariff row attached to each
# invoice; across his eighteen months it moves between 27,416 and 34,072.
TARIFF_LBP_PER_KWH=30981
CURRENCY=LBP

# --- Demo behaviour ---------------------------------------------
# false (default) = a new account starts with NO consumption data.
#   This matches the architecture: smart-meter integration is listed as a
#   FUTURE enhancement (Section XI), and consumption is loaded in bulk
#   through the data pipeline:
#     python -m app.pipeline.ingest --consumption readings.csv --rebuild-ai
# true = new accounts get a generated 12-month history. Use only when you
#   need a self-populating account for a demo.
PROVISION_DEMO_DATA=false

# --- AI Chatbot (optional) --------------------------------------
# Leave empty to use the built-in rule-based assistant, which answers
# from the customer's real account data and needs no API key.
# The key is not required: with no key the question interface still
# answers every question in its catalogue, because the numbers come
# from SQL and the sentence is written by the query that fetched them.
# NEVER commit a real key. This file is the example; .env is gitignored.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- CRM (VoltIQ unified) -----------------------------------------
# Fixed charge added to every invoice the CRM issues from a meter reading.
FIXED_CHARGE_PER_INVOICE=0

# --- Demo deploys only ---------------------------------------------
# true = a server that starts on an EMPTY database loads the demo data and the
# demo logins (passwords are public). Never true for real customer data.
SEED_DEMO_DATA_ON_EMPTY_DB=false
