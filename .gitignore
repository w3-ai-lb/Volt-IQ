# ---------------------------------------------------------------------------
# Repository-wide ignore rules.
#
# The backend has its own .gitignore for Python-specific entries; this covers
# the whole project, including the React frontend.
# ---------------------------------------------------------------------------

# --- Secrets ---------------------------------------------------------------
# Never commit real credentials. .env.example is committed instead, so a new
# clone knows which variables it needs without learning anyone's keys.
.env
.env.local
.env.*.local
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.Python
venv/
env/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / React ----------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local

# --- Database --------------------------------------------------------------
# Generated by `python -m app.pipeline.seed`, so it never needs committing,
# and a committed database goes stale the moment anyone touches the schema.
*.db
*.sqlite
*.sqlite3
backups/

# --- Model artifacts -------------------------------------------------------
# Derived from the database and rebuilt on demand. See app/ai/forecasting.py.
backend/app/ai/artifacts/*
!backend/app/ai/artifacts/.gitignore

# --- Editors and OS --------------------------------------------------------
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# .vscode is deliberately NOT ignored: settings.json and extensions.json in it
# are project configuration that every contributor should get.

# --- Logs and temporary files ----------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
*.tmp
_to_delete/

# Private operational imports and release-local settings
backend/data/ishtirak/
backend/data/crm/
.env.*
!.env.example
*.jks
*.keystore
.dart_tool/
