# Settings for `docker compose up`. Copy to deploy/.env and change every value.
# (deploy/.env is ignored by git; never commit it.)

POSTGRES_PASSWORD=change-me-strong-database-password

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# The web app is served by the same nginx as the API, so the browser calls /api
# on the same address and CORS is not involved. Keep localhost for local tests.
CORS_ORIGINS=http://localhost

# Optional: lets the assistant use an OpenAI model. Leave empty for the built-in one.
OPENAI_API_KEY=

CURRENCY=LBP
TARIFF_LBP_PER_KWH=30981
FIXED_CHARGE_PER_INVOICE=0

# true only for a demo machine: fills an empty database with demo data and
# public demo passwords.
SEED_DEMO_DATA_ON_EMPTY_DB=false
