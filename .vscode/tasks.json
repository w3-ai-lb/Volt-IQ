{
  // Terminal > Run Task... in VS Code.
  // "VoltIQ: start everything" runs the API and the web app side by side.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VoltIQ: API (backend)",
      "type": "shell",
      "command": "python -m uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "VoltIQ: web app (frontend)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "VoltIQ: start everything",
      "dependsOn": ["VoltIQ: API (backend)", "VoltIQ: web app (frontend)"],
      "problemMatcher": []
    },
    {
      "label": "VoltIQ: load demo data",
      "type": "shell",
      "command": "python -m app.pipeline.seed",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "VoltIQ: run tests",
      "type": "shell",
      "command": "python -m pytest tests/test_crm.py -q && python -m tests.test_security",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    }
  ]
}
